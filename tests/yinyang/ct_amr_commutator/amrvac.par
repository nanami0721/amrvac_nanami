&filelist
 base_filename='ct-commutator'
 autoconvert=.false.
/
&savelist
 ditsave_log=100
 ditsave_dat=100
/
&stoplist
 it_max=0
/
&methodlist
 ct_stage_split=T
 yy_ct_experimental=T
 time_stepper='threestep'
 flux_scheme=20*'hll'
 limiter=20*'minmod'
/
&boundlist
 typeboundary_min1=8*'cont'
 typeboundary_max1=8*'cont'
 typeboundary_min2=8*'cont'
 typeboundary_max2=8*'cont'
 typeboundary_min3=8*'cont'
 typeboundary_max3=8*'cont'
/
&meshlist
 refine_max_level=2
 refine_criterion=1
 max_blocks=240
 block_nx1=4
 block_nx2=4
 block_nx3=4
 domain_nx1=8
 domain_nx2=12
 domain_nx3=32
 xprobmin1=1.d0
 xprobmax1=2.d0
 xprobmin2=0.09765625d0
 xprobmax2=0.40234375d0
 xprobmin3=-0.40234375d0
 xprobmax3=0.40234375d0
/
&mhd_list
 typedivbfix='ct'
 type_ct='uct_hll'
 boundary_divbfix=6*.false.
/
