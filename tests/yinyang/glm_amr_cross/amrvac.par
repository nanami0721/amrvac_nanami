&filelist
 base_filename='cross'
 autoconvert=.false.
/
&savelist
 itsave(1,1)=0
 itsave(1,2)=0
 ditsave_log=1
 ditsave_dat=1
/
&stoplist
 it_max=6
/
&methodlist
 time_stepper='threestep'
 flux_scheme=20*'hll'
 limiter=20*'minmod'
/
&boundlist
 typeboundary_min1=8*'cont'
 typeboundary_max1=8*'cont'
 typeboundary_min2=8*'cont'
 typeboundary_max2=8*'cont'
 typeboundary_min3=8*'cont'
 typeboundary_max3=8*'cont'
/
&meshlist
 refine_max_level=4
 refine_criterion=1
 max_blocks=224
 block_nx1=8
 block_nx2=8
 block_nx3=8
 domain_nx1=16
 domain_nx2=32
 domain_nx3=80
 xprobmin1=1.d0
 xprobmax1=2.d0
 xprobmin2=0.109375d0
 xprobmax2=0.390625d0
 xprobmin3=-0.390625d0
 xprobmax3=0.390625d0
/
&paramlist
 courantpar=0.1d0
/
&mhd_list
 boundary_divbfix(1)=T
 typedivbfix='glm'
/
