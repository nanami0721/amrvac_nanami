&filelist
 base_filename='ct-amr'
 autoconvert=.false.
/
&savelist
 itsave(1,1)=0
 itsave(1,2)=0
 ditsave_log=1
 ditsave_dat=5
/
&stoplist
 it_max=6
/
&methodlist
 ct_stage_split=T
 yy_ct_experimental=T
 time_stepper='threestep'
 flux_scheme=20*'tvdlf'
 limiter=20*'minmod'
/
&boundlist
 typeboundary_min1=8*'cont'
 typeboundary_max1=8*'cont'
 typeboundary_min2=8*'cont'
 typeboundary_max2=8*'cont'
 typeboundary_min3=8*'cont'
 typeboundary_max3=8*'cont'
/
&meshlist
 refine_max_level=2
 max_blocks=256
 block_nx1=4
 block_nx2=4
 block_nx3=4
 domain_nx1=12
 domain_nx2=16
 domain_nx3=48
 xprobmin1=1.d0
 xprobmax1=2.d0
 xprobmin2=0.109375d0
 xprobmax2=0.390625d0
 xprobmin3=-0.390625d0
 xprobmax3=0.390625d0
/
&paramlist
 dtpar=0.001d0
 courantpar=0.3d0
/
&mhd_list
 typedivbfix='ct'
 type_ct='uct_hll'
 boundary_divbfix=6*.false.
/
